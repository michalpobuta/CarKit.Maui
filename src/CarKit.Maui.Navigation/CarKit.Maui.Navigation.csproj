<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CarKitIosTargetFrameworks);net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Description>Turn-by-turn navigation for CarPlay and Android Auto with CarKit.Maui: map surfaces, navigation session, maneuvers, lanes, estimates, alerts, voice prompts, CarPlay Dashboard and instrument cluster.</Description>
    <PackageTags>$(PackageTags);navigation;maps;turn-by-turn</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <!-- Platform-neutral logic (Navigation/) is tested by tests/CarKit.Maui.Tests (linked sources); renderers, surfaces
       and voice by DeviceTests -->
  <ItemGroup>
    <InternalsVisibleTo Include="CarKit.Maui.DeviceTests" />
  </ItemGroup>

  <!-- The package tells the CarKit.Maui targets that the module is in the app (dashboard and cluster scenes,
       POI/weather map surface) -->
  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=none: the buildTransitive targets and the CarKit.Maui generator reach an app that references
         only the module -->
    <ProjectReference Include="..\CarKit.Maui\CarKit.Maui.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
