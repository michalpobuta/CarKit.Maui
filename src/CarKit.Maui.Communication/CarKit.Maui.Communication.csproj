<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CarKitIosTargetFrameworks);net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Description>Messaging and calling for CarPlay and Android Auto with CarKit.Maui: conversations, MessagingStyle notifications with reply, CarPlay notification category, Siri (Intents Extension) and CallKit.</Description>
    <PackageTags>$(PackageTags);messaging;communication;siri;callkit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <!-- Neutral logic (Communication/) is tested by tests/CarKit.Maui.Tests (linked sources), the platforms by DeviceTests -->
  <ItemGroup>
    <InternalsVisibleTo Include="CarKit.Maui.DeviceTests" />
  </ItemGroup>

  <!-- The package tells the CarKit.Maui targets that the module is in the app (notification action receiver, Siri,
       App Group) -->
  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=none: the buildTransitive targets and the CarKit.Maui generator reach an app that references
         only the module -->
    <ProjectReference Include="..\CarKit.Maui\CarKit.Maui.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
