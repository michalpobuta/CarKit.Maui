<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CarKit.Maui</RootNamespace>
    <Description>Template model, session, template stack and validator of CarKit.Maui for Apple CarPlay and Android Auto. No MAUI dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rules/*.json" LogicalName="CarKit.Maui.Rules.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The platform SPI (ICarHost, CarSession, validator) is internal: renderers, modules and Testing see it through IVT -->
  <ItemGroup>
    <InternalsVisibleTo Include="CarKit.Maui" />
    <InternalsVisibleTo Include="CarKit.Maui.Media" />
    <InternalsVisibleTo Include="CarKit.Maui.Communication" />
    <InternalsVisibleTo Include="CarKit.Maui.Navigation" />
    <InternalsVisibleTo Include="CarKit.Maui.Testing" />
    <InternalsVisibleTo Include="CarKit.Maui.Core.Tests" />
    <InternalsVisibleTo Include="CarKit.Maui.Tests" />
    <InternalsVisibleTo Include="CarKit.Maui.DeviceTests" />
  </ItemGroup>
</Project>
