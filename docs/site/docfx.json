{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [ { "src": "../../artifacts/docs/api-src/core", "files": [ "CarKit.Maui.Core.dll", "CarKit.Maui.Testing.dll" ] } ],
      "dest": "api/core"
    },
    {
      "src": [ { "src": "../../artifacts/docs/api-src/ios", "files": [ "CarKit.Maui.dll", "CarKit.Maui.Media.dll", "CarKit.Maui.Communication.dll", "CarKit.Maui.Navigation.dll" ] } ],
      "dest": "api/ios"
    },
    {
      "src": [ { "src": "../../artifacts/docs/api-src/android", "files": [ "CarKit.Maui.dll", "CarKit.Maui.Media.dll", "CarKit.Maui.Communication.dll", "CarKit.Maui.Navigation.dll" ] } ],
      "dest": "api/android"
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml", "articles/**/*.md", "articles/**/toc.yml", "api/index.md", "api/toc.yml", "api/core/*.yml", "api/ios/*.yml", "api/android/*.yml" ] }
    ],
    "output": "../../artifacts/docs/_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appTitle": "CarKit.Maui",
      "_appName": "CarKit.Maui",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
